# 本机专用配置模板：复制为 .env 后按需修改（.env 已在 .gitignore 中，不要提交）
#
# 命名规则：REAL_CUGAN_ + 字段名大写；嵌套字段用双下划线分隔。
# 这里适合放「因人而异、不该进仓库」的值，例如本机绝对路径、显卡号。
# 与 config/config.yml 同时存在时，本文件的优先级更高；命令行参数优先级最高。

# 指定显卡
REAL_CUGAN_DEVICE=cuda:0

# 视频命令的输入输出路径（等价于命令行 -i / -o）
# REAL_CUGAN_VIDEO__INPUT=D:\videos\input.mp4
# REAL_CUGAN_VIDEO__OUTPUT=D:\videos\output.mp4

# 图像命令的输入输出目录
# REAL_CUGAN_IMAGE__INPUT=D:\pictures\pending
# REAL_CUGAN_IMAGE__OUTPUT_DIR=D:\pictures\finish

# 其它常用覆盖示例
# REAL_CUGAN_SCALE=3
# REAL_CUGAN_DENOISE=conservative
# REAL_CUGAN_TILE=0
# REAL_CUGAN_CACHE_MODE=3
# REAL_CUGAN_ALPHA=1.0
# REAL_CUGAN_VIDEO__NT=4
# REAL_CUGAN_VIDEO__N_GPU=2
